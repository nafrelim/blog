# Copy this file to .env in blog_be/ and fill in the two required secrets.
# Never commit .env. Both local Django and Docker Compose use this file.

# Local Django connects to the PostgreSQL server on this host and port.
# Docker Compose overrides these two values inside the backend container.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=blog
DB_USER=blog
DB_PASSWORD=

# Public ports on the host. The container ports stay 8000 (API) and 8080 (UI).
BE_PORT=8000
FE_PORT=8080

# Browser-facing URLs. Keep these in sync with BE_PORT and FE_PORT.
BLOG_API_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1

DEBUG=True
SECRET_KEY=
